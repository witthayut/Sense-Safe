# Copy this file to `.env` (same folder) and put your own key in it.
# `.env` is gitignored — never commit a real key.
#
# Google Maps browser key. In Google Cloud restrict it to:
#   Websites: http://localhost:8090/*  and  http://127.0.0.1:8090/*
#   APIs:     Maps JavaScript API, Directions API, Places API
GOOGLE_MAPS_API_KEY=
