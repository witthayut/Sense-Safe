rules_version = '2';

// Per-user isolation: a signed-in user can read/write ONLY their own
// users/{uid} document. Everything else (other users' docs, unauthenticated
// access, unknown collections) is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
